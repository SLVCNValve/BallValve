---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import InquiryCTA from '../components/InquiryCTA.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const products = await getCollection('products');
const categories = [['Electric Ball Valves','electric-hp.png'],['Pneumatic Ball Valves','pneumatic-threaded.jpg'],['Manual Ball Valves','forged-lockable.jpg'],['Flanged Ball Valves','trunnion-class2500.jpg'],['Threaded Ball Valves','pneumatic-threaded.jpg'],['3-Way Ball Valves','electric-3way-flanged.jpg'],['High Pressure Ball Valves','pneumatic-hp-assembly.png'],['Trunnion Ball Valves','trunnion-class2500.jpg']];
const severeServices = [['DBB Ball Valves','Double block and bleed isolation','dbb-handle.jpg'],['Cryogenic Ball Valves','Reliable performance at low temperatures','cryogenic-pair.jpg'],['Metal Seated Ball Valves','High-temperature and abrasion resistance','fully-welded.jpg'],['Fully Welded Ball Valves','Leak-tight, maintenance-free design','fully-welded.jpg']];
---
<BaseLayout title="Industrial Ball Valve Manufacturer | SLVCN Valve" description="SLVCN manufactures standard and severe-service industrial ball valves for global applications.">
  <section class="showcase"><div class="container showcase-grid"><div class="showcase-copy"><h1>Industrial<br />Ball Valve<br />Manufacturer</h1><p>Standard and severe-service ball valve solutions for global industrial applications.</p><div><a class="button blue" href={`${base}products/`}>Explore Products <span>→</span></a><a class="button outline-blue" href={`${base}contact/`}>Send RFQ <span>→</span></a></div></div><div class="showcase-products"><img class="showcase-main" src={`${base}images/products/trunnion-class2500.jpg`} alt="SLVCN trunnion-mounted ball valve" fetchpriority="high" /><img class="showcase-electric" src={`${base}images/products/electric-hp.png`} alt="SLVCN electric actuated ball valve" fetchpriority="high" /><img class="showcase-manual" src={`${base}images/products/forged-lockable.jpg`} alt="SLVCN manual ball valve" fetchpriority="high" /></div></div><div class="container credentials"><div><b>▣</b><strong>20+</strong><span>Years Experience</span></div><div><b>◎</b><strong>100+</strong><span>Countries & Regions</span></div><div><b>CE</b><strong>CE</strong><span>Certified</span></div><div><b>ISO</b><strong>ISO 9001</strong><span>Certified</span></div></div></section>
  <section class="home-section category-section"><h2>Ball Valve Categories</h2><div class="container category-grid">{categories.map(([label, image]) => <a href={`${base}products/`} class="category-card"><img src={`${base}images/products/${image}`} alt={label} loading="lazy" /><span>{label}</span></a>)}</div><a class="view-all" href={`${base}products/`}>View All Products <span>→</span></a></section>
  <section class="container company-panel"><div class="company-image"><img src={`${base}images/Banner.jpg`} alt="SLVCN valve manufacturing facility" loading="lazy" /><div class="company-numbers"><span><b>20+</b>Years Experience</span><span><b>100+</b>Countries Served</span><span><b>2000+</b>Projects Completed</span><span><b>50,000+</b>Valves Delivered</span></div></div><div class="company-copy"><h2>Jiangsu Shoulong Valve Co., Ltd.</h2><p>SLVCN is a professional industrial valve manufacturer specializing in ball valve solutions for severe-service applications. We deliver reliable, high-performance products and responsive technical support worldwide.</p><ul><li><b>Advanced Manufacturing</b><span>CNC machining, automated assembly and strict quality control.</span></li><li><b>Global Reach</b><span>Exported to 100+ countries and regions around the world.</span></li><li><b>Customization Support</b><span>Engineered options to meet your specific requirements.</span></li></ul><a class="button outline-blue" href={`${base}about/`}>Learn More About Us <span>→</span></a></div></section>
  <section class="home-section featured-products"><h2>Featured Products</h2><div class="container product-grid compact-products">{products.slice(0, 6).map(product => <ProductCard product={product} />)}</div><a class="view-all" href={`${base}products/`}>View All Products <span>→</span></a></section>
  <section class="home-section severe-section"><h2>Severe Service Solutions</h2><div class="container severe-grid">{severeServices.map(([title, text, image]) => <a href={`${base}products/`} class="severe-card" style={`background-image:linear-gradient(90deg,rgba(5,35,66,.9),rgba(5,35,66,.48)),url(${base}images/products/${image})`}><strong>{title}</strong><span>{text}</span></a>)}</div></section>
  <InquiryCTA title="Need Ball Valve Selection Support?" />
</BaseLayout>
<style is:global>.showcase{position:relative;z-index:1;overflow:visible}</style>

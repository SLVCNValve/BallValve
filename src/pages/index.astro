---
import BaseLayout from '../layouts/BaseLayout.astro'; import ProductCard from '../components/ProductCard.astro'; import InquiryCTA from '../components/InquiryCTA.astro'; import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const products = await getCollection('products');
const featuredProducts = products.slice(0, 6);
---
<BaseLayout title="SLVCN Valve | Industrial Ball Valve Manufacturer" description="Industrial ball valves engineered for critical oil and gas, chemical, LNG, water, and pipeline flow-control applications.">
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">INDUSTRIAL BALL VALVE MANUFACTURER</p><h1>Engineered control.<br /><em>Built for certainty.</em></h1><p>From standard isolation to severe-service projects, SLVCN delivers ball valve configurations shaped around your process conditions.</p><div class="hero-actions"><a class="button" href={`${base}products/`}>Explore Ball Valves <span>→</span></a><a class="button secondary" href={`${base}contact/`}>Talk to an Engineer</a></div></div><div class="hero-visual"><img src={`${base}images/products/electric-hp.png`} alt="Electric actuated high-pressure industrial ball valve" fetchpriority="high" /></div></div></section>
  <section class="trust-bar"><div class="container"><div class="trust-item"><strong>20<span>+</span></strong><p>Years in valve manufacturing</p></div><div class="trust-item"><strong>API / ISO</strong><p>Standards-led engineering</p></div><div class="trust-item"><strong>100<span>%</span></strong><p>Pressure-tested before shipment</p></div><div class="trust-item"><strong>24<span>h</span></strong><p>Engineering response target</p></div></div></section>
  <section class="featured section"><div class="container"><div class="section-heading"><div><p class="eyebrow">PRODUCT PORTFOLIO</p><h2>Ball valves for<br />every critical duty.</h2></div><p>Explore proven valve families, then configure the materials, pressure class, seals, and actuation for your application.</p></div><div class="product-grid">{featuredProducts.map(product => <ProductCard product={product} />)}</div></div></section>
  <section class="capability section"><div class="container"><div class="capability-grid"><div class="capability-media"><img src={`${base}images/products/pneumatic-hp-assembly.png`} alt="Pneumatic high-pressure valve assembly" loading="lazy" /></div><div class="capability-copy"><p class="eyebrow">APPLICATION-LED ENGINEERING</p><h2>Clear answers for complex service.</h2><p>Share the medium, pressure, temperature, size, and operating conditions. Our engineers translate them into a practical valve configuration, inspection plan, and RFQ response.</p><a class="button secondary" href={`${base}manufacturing/`}>Explore Our Capabilities →</a></div></div><div class="cap-list"><article><span>01</span><h3>Application Engineering</h3><p>Valve design matched to media, cycling, shutoff, and automation needs.</p></article><article><span>02</span><h3>Quality Verification</h3><p>Inspection and traceability aligned with API, ASME, ISO, and project requirements.</p></article><article><span>03</span><h3>Project Support</h3><p>Responsive technical communication from selection through delivery and after-sales.</p></article></div></div></section>
  <InquiryCTA title="Specify the valve your process actually needs." />
</BaseLayout>

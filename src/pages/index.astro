---
import BaseLayout from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro'; import ProductCard from '../components/ProductCard.astro'; import InquiryCTA from '../components/InquiryCTA.astro'; import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const products = await getCollection('products');
const featuredProducts = products.filter(product => product.data.image);
---
<BaseLayout><Hero /><section class="container stats"><div><strong>20<span>+</span></strong><p>Years of valve manufacturing</p></div><div><strong>46</strong><p>Countries and regions served</p></div><div><strong>100<span>%</span></strong><p>Pressure-tested before shipment</p></div><div><strong>24<span>h</span></strong><p>Engineering response commitment</p></div></section><section class="section container"><div class="section-heading"><div><p class="eyebrow">PRODUCT PORTFOLIO</p><h2>Valve systems built<br />for the application.</h2></div><p>We balance pressure, temperature, media, and standards to find the right fit for your system.</p></div><div class="product-grid">{featuredProducts.map(product => <ProductCard product={product} />)}</div></section><section class="dark section"><div class="container"><div class="capabilities"><div class="orb"></div><div><p class="eyebrow">ENGINEERING, NOT GUESSWORK</p><h2>Turn complex service<br />into clear answers.</h2><p>Our engineering team turns process conditions into verified valve configurations. Material traceability, analysis, and full-process inspection deliver reliability beyond the data sheet.</p><a href={`${base}manufacturing/`}>Explore our capabilities →</a></div></div><div class="cap-list"><article><span>01</span><h3>Application Engineering</h3><p>We match size, materials, sealing, and actuation to your process conditions.</p></article><article><span>02</span><h3>Quality Verification</h3><p>Key performance is tested and traceable against API, ASME, ISO, and project requirements.</p></article><article><span>03</span><h3>Lifecycle Support</h3><p>Installation guidance, spare parts, and maintenance support keep systems running reliably.</p></article></div></div></section><InquiryCTA /></BaseLayout>

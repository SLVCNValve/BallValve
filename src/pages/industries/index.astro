---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import InquiryCTA from '../../components/InquiryCTA.astro';
const industries = [{name:'Oil & Gas',text:'From wellhead to transmission pipeline, designed for high pressure, corrosion, and critical isolation.'},{name:'Chemical & Refining',text:'Material compatibility, low-emissions sealing, and stable control for demanding process media.'},{name:'LNG & Industrial Gas',text:'Validated sealing solutions for cryogenic temperatures and safe operation.'},{name:'Energy & District Heating',text:'Dependable isolation for power, district heating, and city-gas networks.'},{name:'Water & Environmental',text:'Durable, serviceable valve configurations for water and environmental systems.'},{name:'Pulp & Mining',text:'Engineered for abrasive, solids-bearing, and high-viscosity media.'}];
---
<BaseLayout title="Industries | BallValve"><section class="page-hero"><div class="container"><Breadcrumb current="Industries" /><p class="eyebrow">INDUSTRIES</p><h1 class="title">Understand the medium.<br /><em>Redefine reliability.</em></h1><p>Every industry has different operating limits. Our valve solutions begin with the process itself.</p></div></section><section class="section container"><div class="article-grid">{industries.map(industry => <article class="article-card"><p class="eyebrow">INDUSTRY</p><h3>{industry.name}</h3><p>{industry.text}</p></article>)}</div></section><InquiryCTA /></BaseLayout>

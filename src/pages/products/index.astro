---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumb from '../../components/Breadcrumb.astro'; import ProductCard from '../../components/ProductCard.astro'; import ProductTable from '../../components/ProductTable.astro'; import InquiryCTA from '../../components/InquiryCTA.astro'; import { getCollection } from 'astro:content';
const products = await getCollection('products');
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Industrial Ball Valve Products | SLVCN Valve" description="Explore SLVCN floating, trunnion-mounted, three-way, cryogenic, DBB, fully welded and V-port industrial ball valves.">
  <section class="page-hero"><div class="container"><Breadcrumb current="Products" /><p class="eyebrow">PRODUCT PORTFOLIO</p><h1 class="title">Ball valves built for<br /><em>your service conditions.</em></h1><p>Floating, trunnion-mounted, and engineered ball valve solutions for standard supply, automation, and severe-service projects.</p></div></section>
  <section class="section container"><div class="catalog-intro"><div><p class="eyebrow">SELECT A VALVE FAMILY</p><h2 class="display">Find your starting point.</h2></div><p>Each family provides a proven platform for your required pressure, media, temperature, end connection, and actuation package.</p></div><div class="product-family-grid"><a href="electric-ball-valves/" class="product-family-card"><img src={`${base}images/products/electric-hp.png`} alt="Electric actuated ball valve" loading="lazy" /><div><p class="eyebrow">AUTOMATED CONTROL</p><h3>Electric Ball Valves</h3><span>Explore range →</span></div></a><a href="pneumatic-ball-valves/" class="product-family-card"><img src={`${base}images/products/pneumatic-hp.png`} alt="Pneumatic actuated ball valve" loading="lazy" /><div><p class="eyebrow">FAST ACTUATION</p><h3>Pneumatic Ball Valves</h3><span>Explore range →</span></div></a><a href="trunnion-mounted-ball-valves/" class="product-family-card"><img src={`${base}images/products/trunnion-class900.jpg`} alt="Trunnion-mounted ball valve" loading="lazy" /><div><p class="eyebrow">FIXED BALL DESIGN</p><h3>Trunnion-Mounted Ball Valves</h3><span>Explore range →</span></div></a></div><nav class="filter-row" aria-label="Product categories"><a href="#all-products">All ball valves</a><a href="electric-ball-valves/">Electric</a><a href="pneumatic-ball-valves/">Pneumatic</a><a href="trunnion-mounted-ball-valves/">Trunnion-mounted</a></nav><div id="all-products" class="product-grid">{products.map(product => <ProductCard product={product} />)}</div></section>
  <section class="comparison section"><div class="container"><div class="section-heading"><div><p class="eyebrow">QUICK COMPARISON</p><h2>Review the key ranges.</h2></div><p>Values shown are typical product-family options. Confirm final selection against the project datasheet.</p></div><ProductTable products={products} /></div></section>
  <InquiryCTA title="Need help narrowing down the right valve family?" />
</BaseLayout>
<style>
  .product-family-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:30px}.product-family-card{display:grid;grid-template-columns:44% 1fr;min-height:190px;border:1px solid var(--line);background:#fff;color:var(--ink);text-decoration:none;transition:box-shadow .2s,border-color .2s}.product-family-card:hover{border-color:var(--blue);box-shadow:0 8px 22px rgba(8,103,217,.13)}.product-family-card img{width:100%;height:100%;min-height:190px;object-fit:contain;background:var(--ice);mix-blend-mode:multiply}.product-family-card>div{display:flex;flex-direction:column;justify-content:center;padding:18px}.product-family-card p{margin:0;color:var(--blue);font-size:9px}.product-family-card h3{margin:9px 0 17px;color:var(--navy);font-size:18px;line-height:1.1}.product-family-card span{color:var(--blue);font-size:12px;font-weight:700}@media(max-width:760px){.product-family-grid{grid-template-columns:1fr}.product-family-card{min-height:155px}.product-family-card img{min-height:155px}}
</style>

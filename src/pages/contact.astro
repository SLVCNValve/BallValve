---
import BaseLayout from '../layouts/BaseLayout.astro'; import Breadcrumb from '../components/Breadcrumb.astro'; import { company } from '../data/company';
---
<BaseLayout title="Contact | BallValve"><section class="page-hero"><div class="container"><Breadcrumb current="Contact" /><p class="eyebrow">CONTACT</p><h1 class="title">Tell us about<br /><em>your application.</em></h1><p>Share the media, pressure, temperature, size, and applicable standards. Our engineering team will respond promptly.</p></div></section><section class="section container contact-grid"><div class="contact-details"><p class="eyebrow">DIRECT CONTACT</p><h2 style="font-size:35px">Engineering Inquiry</h2><p><a href={`mailto:${company.email}`}>{company.email}</a></p><p><a href={`https://wa.me/${company.whatsapp}`}>Contact us on WhatsApp</a></p><p>Response target: within 24 business hours</p></div><form id="inquiry"><label>Your Name<input required name="name" placeholder="How should we address you?" /></label><label>Business Email<input required type="email" name="email" placeholder="name@company.com" /></label><label>Application Details<textarea required name="message" placeholder="Media, pressure, size, standards, and any other key requirements"></textarea></label><button class="button" type="submit">Send Inquiry →</button></form></section></BaseLayout>
<script is:inline define:vars={{ email: company.email }}>document.querySelector('#inquiry')?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(e.currentTarget);location.href=`mailto:${email}?subject=${encodeURIComponent('BallValve inquiry: '+d.get('name'))}&body=${encodeURIComponent('Name: '+d.get('name')+'\\nEmail: '+d.get('email')+'\\n\\nApplication details:\\n'+d.get('message'))}`})</script>

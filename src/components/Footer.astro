---
import { company } from '../data/company';
const base = import.meta.env.BASE_URL;
---
<footer><div class="container"><a class="footer-brand" href={base}>SLVCN <span>VALVE</span></a><p>© {new Date().getFullYear()} {company.name}. INDUSTRIAL FLOW CONTROL.</p><a href={`mailto:${company.email}`}>{company.email}</a></div></footer>
<style>footer{background:#061e31;color:#b8cad4;padding:34px 0}footer>div{display:flex;justify-content:space-between;align-items:center;gap:20px}.footer-brand{font:700 18px Arial,sans-serif;letter-spacing:1px;color:#fff;text-decoration:none}.footer-brand span{color:var(--cyan);font-weight:400}footer p,footer a:not(.footer-brand){font:10px ui-monospace,monospace;color:#b8cad4;text-decoration:none}@media(max-width:760px){footer>div{display:block}footer p{margin:17px 0}}</style>

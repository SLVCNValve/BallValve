---
import { company } from '../data/company';
const base = import.meta.env.BASE_URL;
---
<footer><div class="container"><a class="brand" href={base}><span class="brand-dot"></span>Ball<span>Valve</span></a><p>© {new Date().getFullYear()} BALLVALVE. INDUSTRIAL FLOW CONTROL.</p><a href={`mailto:${company.email}`}>{company.email}</a></div></footer>
<style>footer{background:var(--ink);color:#d0dad5;padding:32px 0}footer>div{display:flex;justify-content:space-between;align-items:center;gap:20px}.brand{font-size:19px;font-weight:800;color:var(--cream);text-decoration:none}.brand span{color:var(--orange)}.brand-dot{display:inline-block;width:16px;height:16px;border:4px solid var(--cream);border-radius:50%;margin-right:6px;vertical-align:-2px}footer p,footer a:not(.brand){font:10px ui-monospace,monospace;color:#d0dad5;text-decoration:none}@media(max-width:700px){footer>div{display:block}footer p{margin:17px 0}}</style>

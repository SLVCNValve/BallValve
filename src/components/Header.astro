---
import { navItems } from '../data/company';
const base = import.meta.env.BASE_URL;
---
<header class="header"><div class="container header-inner"><a class="brand" href={base} aria-label="SLVCN home"><img class="brand-logo" src={`${base}images/logo-header.png`} alt="SLVCN industrial valves" /></a><button class="nav-toggle" aria-label="Open navigation" aria-expanded="false">Menu <span>☰</span></button><nav>{navItems.map(item => <a href={`${base}${item.href.slice(1)}`}>{item.label}</a>)}<a class="header-cta" href={`${base}contact/`}>Request a Quote <span>→</span></a></nav></div></header>
<style>.header{height:80px;position:absolute;z-index:3;width:100%;display:flex;align-items:center;color:#fff;border-bottom:1px solid rgba(255,255,255,.2)}.header-inner{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;height:58px;text-decoration:none}.brand-logo{display:block;height:58px;width:auto;filter:brightness(0) invert(1)}nav{display:flex;align-items:center;gap:25px}nav a{font-size:12px;font-weight:700;text-decoration:none}.header-cta{padding:11px 14px;border:1px solid rgba(255,255,255,.58)}.header-cta span{padding-left:8px;color:var(--cyan)}.nav-toggle{display:none}@media(max-width:760px){.header{height:66px}.brand{height:48px}.brand-logo{height:48px}.nav-toggle{display:block;border:0;background:none;color:#fff;font:700 12px inherit}.nav-toggle span{padding-left:4px}nav{display:none}.header:focus-within nav{display:flex;position:absolute;top:66px;left:0;width:100%;background:var(--navy);padding:20px 8vw;flex-direction:column;align-items:start;gap:20px;border-bottom:1px solid rgba(255,255,255,.2)}}</style>

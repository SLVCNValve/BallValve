---
import { navItems } from '../data/company';
const base = import.meta.env.BASE_URL;
---
<header class="header"><div class="container header-inner"><a class="brand" href={base}><span class="brand-dot"></span>Ball<span>Valve</span></a><button class="nav-toggle" aria-label="Open navigation">Menu</button><nav>{navItems.map(item => <a href={`${base}${item.href.slice(1)}`}>{item.label}</a>)}<a class="header-cta" href={`${base}contact/`}>Get a Quote ↗</a></nav></div></header>
<style>.header{height:78px;position:absolute;z-index:2;width:100%;display:flex;align-items:center}.header-inner{display:flex;align-items:center;justify-content:space-between}.brand{font-weight:800;font-size:20px;letter-spacing:-1px;text-decoration:none}.brand span{color:var(--orange)}.brand-dot{display:inline-block;width:18px;height:18px;margin-right:7px;border:5px solid var(--ink);border-radius:50%;vertical-align:-2px;position:relative}.brand-dot:after{content:"";position:absolute;background:var(--orange);width:6px;height:6px;border-radius:50%;right:-8px;top:-8px}nav{display:flex;align-items:center;gap:23px}nav a{font-size:12px;font-weight:700;text-decoration:none}.header-cta{padding:10px 13px;background:var(--ink);color:var(--cream)}.nav-toggle{display:none}@media(max-width:700px){.header{height:65px}.nav-toggle{display:block;border:0;background:none;font:700 12px inherit}nav{display:none}.header:focus-within nav{display:flex;position:absolute;top:65px;left:0;width:100%;background:var(--cream);padding:20px 6vw;flex-direction:column;align-items:start}}</style>

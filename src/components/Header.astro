---
import { navItems } from '../data/company';
const base = import.meta.env.BASE_URL;
---
<header class="header"><div class="container header-inner"><a class="brand" href={base} aria-label="SLVCN home"><img class="brand-logo" src={`${base}images/logo-header.png`} alt="SLVCN industrial valves" /></a><button class="nav-toggle" aria-label="Open navigation" aria-expanded="false">Menu <span>☰</span></button><nav>{navItems.map(item => <a href={`${base}${item.href.slice(1)}`}>{item.label}</a>)}<a class="header-cta" href={`${base}contact/`}>Start an RFQ <span>→</span></a></nav></div></header>
<style>.header{height:80px;position:absolute;z-index:3;width:100%;display:flex;align-items:center;color:#162832;border-bottom:1px solid #dce3e5;background:rgba(255,255,255,.94);backdrop-filter:blur(10px)}.header-inner{display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;height:58px;text-decoration:none}.brand-logo{display:block;height:58px;width:auto}nav{display:flex;align-items:center;gap:27px}nav a{font-size:12px;font-weight:700;text-decoration:none}.header-cta{padding:11px 14px;border:1px solid #162832}.header-cta span{padding-left:8px;color:var(--blue)}.nav-toggle{display:none}@media(max-width:760px){.header{height:66px}.brand{height:48px}.brand-logo{height:48px}.nav-toggle{display:block;border:0;background:none;color:#162832;font:700 12px inherit}.nav-toggle span{padding-left:4px}nav{display:none}.header:focus-within nav{display:flex;position:absolute;top:66px;left:0;width:100%;background:#fff;padding:20px 8vw;flex-direction:column;align-items:start;gap:20px;border-bottom:1px solid #dce3e5}}</style>
